argin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;


body {
    background-color: #fcf9f9;
    color: #333;
}

/* Cabeçalho */
header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 8%;
    background-color: #fff;
    box-shadow: 0 2px 5px rgba(0,0,0,0.05);
    position: sticky;
    top: 0;
    z-index: 100;
}

.logo {
    font-size: 24px;
    font-weight: bold;
    color: #b57c7c;
    letter-spacing: 1px;
}

nav ul {
    display: flex;
    list-style: none;
}

nav ul li {
    margin: 0 15px;
}

nav ul li a {
    text-decoration: none;
    color: #555;
    font-weight: 500;
    transition: color 0.3s;
}

nav ul li a:hover {
    color: #b57c7c;
}

.cart-icon {
    font-size: 20px;
    cursor: pointer;
    position: relative;
}

#cart-count {
    position: absolute;
    top: -10px;
    right: -10px;
    background-color: #b57c7c;
    color: white;
    font-size: 12px;
    padding: 2px 6px;
    border-radius: 50%;
}

/* Banner */
.banner {
    background: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.4)), url('https://unsplash.com') no-repeat center center/cover;
    height: 60vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    color: white;
    padding: 0 20px;
}

.banner h1 {
    font-size: 42px;
    margin-bottom: 15px;
}

.banner p {
    font-size: 18px;
    margin-bottom: 25px;
}

.btn-shop {
    background-color: #b57c7c;
    color: white;
    padding: 12px 30px;
    text-decoration: none;
    font-weight: bold;
    border-radius: 4px;
    transition: background 0.3s;
}

.btn-shop:hover {
    background-color: #966363;
}

/* Vitrine de Produtos */
main {
    padding: 60px 8%;
}

main h2 {
    text-align: center;
    margin-bottom: 40px;
    color: #444;
}

.product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 30px;
}

.product-card {
    background-color: white;
    border-radius: 8px;
    padding: 20px;
    text-align: center;
    box-shadow: 0 4px 15px rgba(0,0,0,0.03);
    transition: transform 0.3s;
}

.product-card:hover {
    transform: translateY(-5px);
}

.product-card img {
    width: 100%;
    border-radius: 6px;
    margin-bottom: 15px;
    object-fit: cover;
}

.product-card h3 {
    font-size: 18px;
    margin-bottom: 10px;
    color: #444;
}

.product-card .price {
    color: #b57c7c;
    font-size: 20px;
    font-weight: bold;
    margin-bottom: 15px;
}

.product-card button {
    background-color: #333;
    color: white;
    border: none;
    padding: 10px 20px;
    border-radius: 4px;
    cursor: pointer;
    width: 100%;
    font-weight: 600;
    transition: background 0.3s;
}

.product-card button:hover {
    background-color: #b57c7c;
}

/* Sidebar do Carrinho */
.sidebar {
    position: fixed;
    top: 0;
    right: -350px;
    width: 350px;
    height: 100%;
    background-color: white;
    box-shadow: -5px 0 15px rgba(0,0,0,0.1);
    transition: right 0.3s ease;
    z-index: 200;
    display: flex;
    flex-direction: column;
}

.sidebar.open {
    right: 0;
}

.sidebar-header {
    display: flex;
    justify-content: space-between;
    padding: 20px;
    border-bottom: 1px solid #eee;
}

.close-btn {
    font-size: 24px;
    cursor: pointer;
}

#itens-carrinho {
    flex: 1;
    overflow-y: auto;
    padding: 20px;
}

.cart-item {
    display: flex;
    justify-content: space-between;
    margin-bottom: 15px;
    padding-bottom: 15px;
    border-bottom: 1px solid #f5f5f5;
}

.sidebar-footer {
    padding: 20px;
    border-top: 1px solid #eee;
    background-color: #fafafa;
}

.btn-checkout {
    background-color: #b57c7c;
    color: white;
    border: none;
    width: 100%;
    padding: 12px;
    margin-top: 15px;
    cursor: pointer;
    font-weight: bold;
    border-radius: 4px;
}

/* Rodapé */
footer {
    text-align: center;
    padding: 30px;
    background-color: #333;
    color: white;
    font-size: 14px;
}